{
  "runcontract": 1,
  "services": [
    {
      "name": "db",
      "kind": "database",
      "engine": "postgres"
    },
    {
      "name": "api",
      "dir": "backend",
      "stack": "python",
      "kind": "server",
      "install": [
        ["${python}", "-m", "pip", "install", "-q", "-r", "requirements.txt"]
      ],
      "build": [
        ["${python}", "-m", "compileall", "-q", "app"]
      ],
      "start": [
        "${python}", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "${PORT}"
      ],
      "port": 8000,
      "port_env": "PORT",
      "health": {
        "path": "/api/health",
        "expect_status": [200]
      },
      "ready_timeout_s": 60,
      "test": [
        ["${python}", "-m", "pytest", "-q"]
      ],
      "seed": [
        ["${python}", "-m", "scripts.seed"]
      ],
      "depends_on": ["db"],
      "env": {
        "DATABASE_URL": { "dev": "${service:db.url}" },
        "JWT_SECRET": { "generate": "hex", "bytes": 32 },
        "ACCESS_TOKEN_TTL_SECONDS": {
          "dev": "900",
          "not_secret": true,
          "why": "access token lifetime in seconds — a plain duration, not a credential"
        },
        "REFRESH_TOKEN_TTL_DAYS": {
          "dev": "14",
          "not_secret": true,
          "why": "refresh token lifetime in days — a plain duration, not a credential"
        },
        "FRONTEND_ORIGIN": { "dev": "${service:web.origin}" },
        "ADMIN_ORIGIN": { "dev": "${service:admin.origin}" }
      }
    },
    {
      "name": "shared",
      "dir": "shared",
      "stack": "python",
      "kind": "library",
      "install": [
        ["${python}", "-m", "pip", "install", "-q", "-e", "."]
      ],
      "test": [
        ["${python}", "-m", "pytest", "-q"]
      ],
      "depends_on": ["db"],
      "env": {
        "DATABASE_URL": { "dev": "${service:db.url}" }
      }
    }
  ]
}
